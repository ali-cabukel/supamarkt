# Copy to .env in this directory (never commit .env)
#
#   cp .env.template .env

# SQLite database path (default: backend/data/supamarkt.db). Ignored when DATABASE_URL is set.
DB_PATH=

# Postgres / Supabase (production). Use schema isolation on a shared Supabase instance.
# DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
# DATABASE_SCHEMA=supamarkt

# Finnhub — https://finnhub.io/register (optional; /stock/candle requires paid plan)
FINNHUB_API_KEY=

# OHLCV source: yfinance (free intraday) or finnhub (paid candle API)
DATA_PROVIDER_PRIMARY=yfinance

# Intraday collection
INTRADAY_INTERVAL=5m
COLLECT_LOOKBACK_DAYS=5
COLLECT_SYMBOL_DELAY_SECONDS=1

# API authentication (change SECRET_KEY in production)
SECRET_KEY=change-me-in-production
JWT_LIFETIME_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
# Bundled Docker / Cloud Run only (FastAPI serves Next static export)
# STATIC_DIR=/app/static

# LLM for future AI features — auto prefers OpenAI when OPENAI_API_KEY is set, else LM Studio
# LLM_PROVIDER=auto | openai | lmstudio | ollama

# OpenAI (production / Cloud Run — https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LM Studio (local OpenAI-compatible server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=lm-studio

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
